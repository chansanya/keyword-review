# Host binding. Keep loopback; the Sub2API container is also reachable by Higress
# over the existing ai-gw Docker network as sub2api:8080.
BIND_HOST=127.0.0.1
BIND_PORT=8081
SERVER_HOST=0.0.0.0
SERVER_PORT=8080
SERVER_MODE=release
AUTO_SETUP=true
TZ=Asia/Shanghai

# Consider pinning an explicit image tag for production.
SUB2API_IMAGE=weishaw/sub2api:latest

# Sub2API requires PostgreSQL. This module starts only PostgreSQL, not MySQL.
POSTGRES_IMAGE=postgres:18-alpine
POSTGRES_DATA_DIR=/var/lib/postgresql/data
DATABASE_HOST=postgres
DATABASE_PORT=5432
DATABASE_USER=sub2api
DATABASE_PASSWORD=REPLACE_WITH_RANDOM_SECRET
DATABASE_DBNAME=sub2api
DATABASE_SSLMODE=disable

# Reuse the existing WSL Redis instead of starting another Redis container.
# The Docker host alias is provided to the Sub2API container by Compose.
REDIS_HOST=host.docker.internal
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_ENABLE_TLS=false

# Generate each secret with: openssl rand -hex 32
JWT_SECRET=REPLACE_WITH_RANDOM_SECRET
TOTP_ENCRYPTION_KEY=REPLACE_WITH_RANDOM_SECRET

# Optional. Leave both blank to let first-run setup create credentials;
# retrieve generated admin credentials from the Sub2API container logs.
ADMIN_EMAIL=
ADMIN_PASSWORD=
