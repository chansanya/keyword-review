# Host binding: keep loopback when publishing behind a local reverse proxy.
# Set 0.0.0.0 only if the host firewall and TLS/reverse proxy are configured.
BIND_HOST=127.0.0.1
SERVER_PORT=8081
TZ=Asia/Shanghai

# Consider pinning an explicit image tag for production.
SUB2API_IMAGE=weishaw/sub2api:latest

POSTGRES_USER=sub2api
POSTGRES_PASSWORD=REPLACE_WITH_RANDOM_SECRET
POSTGRES_DB=sub2api

# Generate each secret with: openssl rand -hex 32
JWT_SECRET=REPLACE_WITH_RANDOM_SECRET
TOTP_ENCRYPTION_KEY=REPLACE_WITH_RANDOM_SECRET

# Optional. Leave both blank to let first-run setup create credentials;
# retrieve the generated admin credentials from the Sub2API container logs.
ADMIN_EMAIL=
ADMIN_PASSWORD=
